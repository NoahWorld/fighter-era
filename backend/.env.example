# Copy to backend/.env for local development; Compose uses /opt/fighter-era/deploy/.env.
# Never commit actual credentials or AppSecret.
NODE_ENV=production
HOST=127.0.0.1
PORT=4317
# Direct mode ignores forwarded headers. Production Compose trusts only its fixed gateway.
TRUST_PROXY_HOPS=0
TRUST_PROXY_ADDRESS=
DATABASE_URL=postgresql://fighter_era:REPLACE_ME@127.0.0.1:5432/fighter_era
WECHAT_APP_ID=wxbc890abdf12df15b
WECHAT_APP_SECRET=
SESSION_TTL_SECONDS=2592000
LOG_LEVEL=info
